{
  "name": "@anil-labs/file-picker-vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings for @anil-labs/file-picker-core — a media-library file picker with folders, upload, filters and metadata editing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue3",
    "file-picker",
    "media-library",
    "file-upload"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Er. Anil Kumar Thakur <anilkumarthakur60@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anilkumarthakur60/file-picker.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/anilkumarthakur60/file-picker/tree/main/packages/vue#readme",
  "bugs": "https://github.com/anilkumarthakur60/file-picker/issues",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anil-labs/file-picker-core": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  }
}
